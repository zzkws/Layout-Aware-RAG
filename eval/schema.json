{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TKD pre-sales RAG eval item (scenario-aware v2)",
  "type": "object",
  "required": ["id", "question", "lang", "persona", "intent", "difficulty", "answerable", "gold_chunks", "gold_facts", "verify_status"],
  "properties": {
    "id": { "type": "string", "pattern": "^tkd-[a-z0-9-]+$" },
    "question": { "type": "string", "minLength": 4 },
    "lang": { "enum": ["zh", "en"] },
    "persona": { "enum": ["硬件工程师", "系统架构师", "代理FAE", "采购", "产品经理", "项目负责人", "创业者", "工程主管(非晶振专业)"] },
    "intent": { "enum": ["spec_lookup", "multi_param", "compare", "application_fit", "constraint_filter", "option_lookup", "cross_reference", "commercial", "package_mech", "solution_recommendation"] },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "answerable": { "type": "boolean" },
    "customer_profile": { "type": "string" },
    "scenario": { "type": "string" },
    "pain_point": { "type": "string" },
    "underlying_need": { "type": "string" },
    "products": { "type": "array", "items": { "type": "string" } },
    "gold_products": { "type": "array", "items": { "type": "string" } },
    "gold_chunks": { "type": "array", "items": { "type": "string" } },
    "gold_facts": { "type": "array", "items": { "type": "string" } },
    "must_not": { "type": "array", "items": { "type": "string" } },
    "verify_status": { "enum": ["verified_image", "from_description", "unverified"] },
    "notes": { "type": "string" }
  }
}
